KPL_API_KEY=replace-with-local-key
KPL_API_BASE=https://kpl.liuhepc.cn/api
KPL_DB_PATH=D:/accio/stock_data/kpl_data.duckdb
KPL_REQUEST_DELAY=0.3

# Optional Tushare-compatible relay. Leave empty to use non-Tushare sources.
TUSHARE_FAST_RELAY_URL=https://fastapic.stockai888.top
TUSHARE_FAST_RELAY_TOKEN=replace-with-local-token
# Relay limit is 100 requests/minute; keep a 0.65s start-to-start interval.
TUSHARE_RELAY_MIN_INTERVAL_SECONDS=0.65

# Optional DeepSeek V4 Flash daily-review provider. Never commit a real token.
DEEPSEEK_API_KEY=replace-with-deepseek-token
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=45
DEEPSEEK_MAX_RETRIES=2
